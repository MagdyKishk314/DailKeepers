# Copy to .env for local use. On Vercel, add these under Project > Settings > Environment Variables.

# The Gmail address that sends the emails, and a Gmail App Password (not your normal password).
SMTP_USER=
SMTP_PASS=

# Where audit requests are emailed.
LEAD_EMAIL_TO=magdy314.work@gmail.com

# Only change these for a provider other than Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
